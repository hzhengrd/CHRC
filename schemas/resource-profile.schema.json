{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hzhengrd.github.io/CHRC/schemas/resource-profile.schema.json",
  "title": "CHRC resource profile (minimum)",
  "description": "Minimum profile for a construction human-robot collaboration (CHRC) data resource, grounded in the H/R/T/E taxonomy. Required blocks: identity, H/R/T/E coverage, scale, and access. Conditional blocks: instantiation and provenance. A value of 'notReported' is an accepted value, so an empty field does not make a resource unregistrable.",
  "type": "object",
  "required": ["id", "name", "creators", "recordBasis", "hrteCoverage", "scale", "access"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Persistent resource identifier (e.g. a DOI or repository-assigned PID)."
    },
    "name": { "type": "string" },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "orcid": { "type": "string" },
          "role": { "type": "string" }
        }
      }
    },
    "version": { "type": "string" },
    "relatedPublications": { "type": "array", "items": { "type": "string" } },
    "recordBasis": {
      "type": "string",
      "enum": ["episode", "elicited", "model-generated", "mixed"],
      "description": "Whether records come from activity episodes, elicited responses, model-generated instances, or a mix."
    },
    "intendedPurpose": { "type": "string" },
    "limitations": { "type": "string" },
    "hrteCoverage": {
      "type": "object",
      "description": "Status of each of the 17 H/R/T/E information categories as captured / notCaptured / notReported.",
      "required": ["human", "robot", "task", "environment"],
      "properties": {
        "human": { "$ref": "#/definitions/referent" },
        "robot": { "$ref": "#/definitions/referent" },
        "task": { "$ref": "#/definitions/referent" },
        "environment": { "$ref": "#/definitions/referent" }
      }
    },
    "crossReferentRelations": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Explicit human-robot relations documented by the resource (communication, handover, proximity, etc.)."
    },
    "scale": {
      "type": "object",
      "description": "Empirical breadth. Numeric fields accept 'notReported' as a string.",
      "properties": {
        "participants": { "type": ["integer", "string"] },
        "robotInstances": { "type": ["integer", "string"] },
        "robotPlatforms": { "type": ["integer", "string"] },
        "focalTasks": { "type": ["integer", "string"] },
        "environmentConfigurations": { "type": ["integer", "string"] },
        "sessionsOrTrials": { "type": ["integer", "string"] },
        "duration": { "type": "string" },
        "setting": { "type": "string", "enum": ["on-site", "off-site production", "laboratory mock-up", "teleoperation", "immersive environment", "simulation", "notReported"] },
        "origin": { "type": "string", "enum": ["real", "synthetic", "mixed", "notReported"] }
      }
    },
    "instantiation": {
      "type": "array",
      "description": "The nine data-instantiation properties, recorded per captured category.",
      "items": { "$ref": "#/definitions/instantiation" }
    },
    "provenance": {
      "type": "object",
      "description": "Collection and annotation procedures, source lineage, transformations, validation, missingness, uncertainty, quality control, and responsible agents."
    },
    "access": {
      "type": "object",
      "required": ["tier", "license"],
      "properties": {
        "tier": {
          "type": "string",
          "enum": ["open", "on-request", "secure-computation", "metadata-only"]
        },
        "license": { "type": "string" },
        "custodian": { "type": "string" },
        "requestProcedure": { "type": "string" },
        "permittedUses": { "type": "array", "items": { "type": "string" } },
        "retention": { "type": "string" }
      }
    }
  },
  "definitions": {
    "referent": {
      "type": "object",
      "description": "Category statuses for one referent; keys are category names, values are captured / notCaptured / notReported.",
      "additionalProperties": { "type": "string", "enum": ["captured", "notCaptured", "notReported"] }
    },
    "instantiation": {
      "type": "object",
      "required": ["category", "modality"],
      "properties": {
        "category": { "type": "string" },
        "modality": { "type": "string" },
        "representationForm": { "type": "string" },
        "unitOfObservation": { "type": "string" },
        "measurementUnit": { "type": "string" },
        "source": { "type": "string" },
        "perspective": { "type": "string" },
        "encodingMethod": { "type": "string" },
        "spatialReference": { "type": "string" },
        "temporalReference": { "type": "string" }
      }
    }
  }
}
